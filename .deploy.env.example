# FTP deploy settings for deploy.sh.
# Copy this file to  .deploy.env  and fill in your real values.
# .deploy.env is git-ignored — it is NEVER committed or pushed to GitHub.

# Your cPanel FTP hostname (or the server IP). Often ftp.<yourdomain> or the
# hostname shown in cPanel > FTP Accounts > "Configure FTP Client".
FTP_HOST=ftp.nineonetwo.online

# FTP username and password (from cPanel > FTP Accounts).
FTP_USER=your_ftp_username
FTP_PASS=your_ftp_password

# The folder the FTP login lands you in, RELATIVE to that account's home,
# up to and including the app folder. Pick the one that matches your account:
#   * Main cPanel FTP account (home is /home4/tonyketter):
#         FTP_REMOTE_DIR=nineonetwo.online/WORKINGCAPITAL
#   * An "addon"/scoped FTP account that already opens INSIDE WORKINGCAPITAL:
#         FTP_REMOTE_DIR=.
FTP_REMOTE_DIR=nineonetwo.online/WORKINGCAPITAL

# 1 = use encrypted FTP (FTPS, recommended on cPanel). Set 0 only if your host
# requires plain FTP.
FTP_TLS=1

# 1 = also push your commits to GitHub when you deploy. 0 = upload only.
GIT_PUSH=1
